daemon off;
worker_processes auto;
error_log {{ log_dir }}/nginx/error.log;
pid {{ pid_file }};

events {
    worker_connections 1024;
}

http {
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent"';
    access_log {{ log_dir }}/nginx/access.log main;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
}

stream {
    log_format stream_main '$remote_addr [$time_local] $protocol $status '
                           '$bytes_sent $bytes_received $session_time';
    access_log {{ log_dir }}/nginx/stream_access.log stream_main;

    upstream backend_workers {
        {% if lb_strategy == 'least_conn' %}
        least_conn;
        {% elif lb_strategy == 'ip_hash' %}
        hash $remote_addr consistent;
        {% endif %}
        {% for port in worker_ports %}
        server 127.0.0.1:{{ port }} max_fails=3 fail_timeout=30s;
        {% endfor %}
    }

    server {
        listen {{ listen_addr }}{% if enable_ssl %} ssl{% endif %};
        proxy_pass backend_workers;
        proxy_connect_timeout 5s;
        {% if enable_ssl %}
        ssl_certificate      {{ ssl_cert }};
        ssl_certificate_key  {{ ssl_key }};
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_ciphers          ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:
                             ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers on;
        {% endif %}
    }
}
