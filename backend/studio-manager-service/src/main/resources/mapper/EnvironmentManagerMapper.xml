<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openjiuwen.studio.agent.manager.mapper.EnvironmentManagerMapper">
    <resultMap id="BaseResultMap" type="com.openjiuwen.studio.agent.manager.entity.EnvironmentManagerEntity">
        <id column="id" jdbcType="VARCHAR" property="id"/>
        <id column="project_id" jdbcType="VARCHAR" property="projectId"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="is_default" jdbcType="TINYINT" property="isDefault"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="resources" jdbcType="VARCHAR" property="resources"/>
        <result column="resources" jdbcType="VARCHAR" property="resources"/>
        <result column="created_on" jdbcType="TIMESTAMP" property="createdOn"/>
        <result column="creator_id" jdbcType="VARCHAR" property="creatorId"/>
        <result column="updated_on" jdbcType="TIMESTAMP" property="updatedOn"/>
        <result column="updater_id" jdbcType="VARCHAR" property="updaterId"/>
        <result column="domain_id" jdbcType="VARCHAR" property="domainId"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        id,
        project_id,
        name,
        description,
        is_default,
        status,
        resources,
        created_on,
        creator_id,
        updated_on,
        updater_id,
        domain_id
        FROM t_environment_manager_info
        WHERE project_id = #{projectId}
        ORDER BY created_on DESC
        LIMIT #{pageOffset}, #{pageSize}
    </select>

    <select id="selectAllByStatus" resultMap="BaseResultMap">
        SELECT
            id,
            project_id,
            name,
            description,
            is_default,
            status,
            resources,
            created_on,
            creator_id,
            updated_on,
            updater_id,
            domain_id
        FROM t_environment_manager_info
        WHERE project_id = #{projectId}
              AND status = #{status}
        ORDER BY created_on DESC
            LIMIT #{pageOffset}, #{pageSize}
    </select>

</mapper>
