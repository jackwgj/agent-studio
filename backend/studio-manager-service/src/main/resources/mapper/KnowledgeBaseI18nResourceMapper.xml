<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openjiuwen.studio.agent.agentbase.mapper.KnowledgeBaseI18nResourceMapper">
    <resultMap id="BaseResultMap" type="com.openjiuwen.studio.agent.agentbase.entity.KnowledgeBaseI18nResourceEntity">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="i18n_key" jdbcType="VARCHAR" property="i18nKey"/>
        <result column="locale" jdbcType="VARCHAR" property="locale"/>
        <result column="message" jdbcType="LONGVARCHAR" property="message"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,
        i18n_key,
        locale,
        message
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_knowledge_i18n_resource
        order by i18n_key, locale
    </select>

    <select id="findByLocale" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_knowledge_i18n_resource
        where locale = #{locale}
        order by i18n_key
    </select>

    <select id="findByKeyAndLocale" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_knowledge_i18n_resource
        where i18n_key = #{i18nKey} and locale = #{locale}
        limit 1
    </select>

    <select id="countByKeyAndLocale" resultType="int">
        select count(1)
        from t_knowledge_i18n_resource
        where i18n_key = #{i18nKey}
          and locale = #{locale}
    </select>
</mapper>