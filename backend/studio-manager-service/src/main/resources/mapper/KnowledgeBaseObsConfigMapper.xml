<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openjiuwen.studio.agent.agentbase.mapper.KnowledgeBaseObsConfigMapper">

    <sql id="baseColumns">
        id
        , knowledge_base_id, obs_bucket_name, obs_input_directory, task_status, domain_id,
        domain_name, created_user_id, created_user_name, create_time, update_user_id,
        update_user_name, update_time, project_id, workspace_id
    </sql>

    <insert id="insert" parameterType="com.openjiuwen.studio.agent.agentbase.entity.KnowledgeBaseObsConfigEntity">
        INSERT INTO t_knowledge_base_obs_config
        (<include refid="baseColumns"></include>)
        VALUES (#{id}, #{knowledgeBaseId}, #{obsBucketName}, #{obsInputDirectory}, #{taskStatus}, #{domainId},
        #{domainName}, #{createdUserId},
        #{createdUserName}, #{createTime}, #{updateUserId},
        #{updateUserName}, #{updateTime}, #{projectId}, #{workspaceId})
    </insert>
    <update id="updateObsTaskStatus">
        update t_knowledge_base_obs_config
        set task_status = #{taskStatus}
        where id = #{id}
    </update>
    <select id="selectByObsConfigId"
            resultType="com.openjiuwen.studio.agent.agentbase.entity.KnowledgeBaseObsConfigEntity">
        select
        <include refid="baseColumns"></include>
        from t_knowledge_base_obs_config
        where id = #{id}
    </select>
    <select id="selectByKnowledgeBaseId"
            resultType="com.openjiuwen.studio.agent.agentbase.entity.KnowledgeBaseObsConfigEntity">
        select
        <include refid="baseColumns"></include>
        from t_knowledge_base_obs_config
        where knowledge_base_id = #{knowledgeBaseId}
    </select>
    <delete id="deleteObsTaskConfig">
        delete
        from t_knowledge_base_obs_config
        where knowledge_base_id = #{knowledgeBaseId}
    </delete>

</mapper>