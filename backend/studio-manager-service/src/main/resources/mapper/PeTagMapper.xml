<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openjiuwen.studio.prompt.engineering.mapper.PeTagMapper">

    <resultMap id="TagResultMap" type="com.openjiuwen.studio.prompt.engineering.entity.PeTag">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="nameEn" column="name_en" jdbcType="VARCHAR"/>
        <result property="createdOn" column="created_on" jdbcType="TIMESTAMP"/>
        <result property="updatedOn" column="updated_on" jdbcType="TIMESTAMP"/>
        <result property="workspaceId" column="workspace_id" jdbcType="VARCHAR"/>
    </resultMap>

    <insert id="insertOneTag">
        insert into t_pe_tag(id, name, name_en, workspace_id) values (#{id}, #{name}, #{nameEn}, #{workspaceId})
    </insert>

    <update id="updateOneTag">
        UPDATE t_pe_tag
        SET name = #{name},
            name_en = #{nameEn}
        WHERE id = #{id} and workspace_id = #{workspaceId}
    </update>

    <delete id="deleteById">
        delete from t_pe_tag where id = #{id} and workspace_id = #{workspaceId}
    </delete>

    <select id="queryByIds" resultMap="TagResultMap">
        select * from t_pe_tag
        <if test="ids != null and !ids.isEmpty()">
            where workspace_id = #{workspaceId} and id IN
            <foreach collection='ids' item='id' open='(' separator=',' close=')'>
                #{id}
            </foreach>
        </if>
        ORDER BY created_on DESC
    </select>

    <select id="isExist" resultType="java.lang.Boolean">
        select 1 from t_pe_tag where name = #{name}  and workspace_id = #{workspaceId} limit 1
    </select>

    <select id="queryAll" resultMap="TagResultMap">
        select * from t_pe_tag ORDER BY updated_on DESC
    </select>
</mapper>
