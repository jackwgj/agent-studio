%s

# execute main function
output_obj = main(**%s)

def dict_to_json(d):
    if isinstance(d, dict):
        items = []
        for key, value in d.items():
            item = f'"{key}": ' + dict_to_json(value)
            items.append(item)
        return "{" + ", ".join(items) + "}"
    elif isinstance(d, list):
        items = []
        for item in d:
            items.append(dict_to_json(item))
        return "[" + ", ".join(items) + "]"
    elif isinstance(d, str):
        return f'"{d}"'
    elif isinstance(d, (int, float, bool)):
        return str(d)
    else:
        raise TypeError(f"Unsupported type: {type(d).__name__}")

result = f'''<<RESULT_START>>{dict_to_json(output_obj)}<<RESULT_END>>'''
print(result)