":"user"}],"responseFormat":{"type":"text"},"model":{"modelName":"free-deepseek-v3","extension":{"deploymentId":"free-deepseek-v3"},"hyperParameters":{"top_p":0.5,"frequency_penalty":0,"temperature":0.5},"modelType":"LLM"},"historySize":3},"inputs":{"userFields":{"query":"${node_start.systemFields.query}"}},"name":"聊天","id":"node_llm","type":"jiuwen.LLMComponent"}],"metadata":{"visibility":"global","publishedAt":null,"userId":"660f2322011748ceaefc45d122111ef2","projectId":"d71609fe080248dcbe275bca76b681b3","domainId":"294b3cc185bd4cca9d69095690159432","workspaceId":"2a9fcbed03d04437b47acd2dba98d8e7","updatedAt":1757990504485,"status":"draft"},"schemaVersion":"0.6.0","description":"云云对话流，支持闲聊、知识问答游戏以及咨询和提问","workflowName":"yunyun_chat","workflowVersion":"0.6.0","workflowId":"1c0e0f70-ca4b-43cf-99ca-d8126fb70ed4","connections":[{"source":{"componentId":"node_1742955501728"},"target":{"componentId":"node_1742955595058"}},{"source":{"componentId":"node_1742955563021"},"target":{"componentId":"node_1742955665959"}},{"source":{"componentId":"node_1742955595058"},"target":{"componentId":"node_1742955665959"}},{"source":{"componentId":"node_1742955097012"},"target":{"componentId":"node_1742955219285"}},{"source":{"componentId":"node_1742955016087"},"target":{"componentId":"node_1742955097012"}},{"source":{"componentId":"node_start"},"target":{"componentId":"node_1742954356446"}},{"source":{"branchId":"node_1742955219285-if","componentId":"node_1742955219285"},"target":{"componentId":"node_1742955306478"}},{"source":{"componentId":"node_1742955665959"},"target":{"componentId":"node_end"}},{"source":{"componentId":"node_1742954828136"},"target":{"componentId":"node_1742955016087"}},{"source":{"componentId":"node_1742955306478"},"target":{"componentId":"node_1742955563021"}},{"source":{"branchId":"node_1742955219285-default","componentId":"node_1742955219285"},"target":{"componentId":"node_1742955501728"}},{"source":{"branchId":"node_1742954356446_branch_2","componentId":"node