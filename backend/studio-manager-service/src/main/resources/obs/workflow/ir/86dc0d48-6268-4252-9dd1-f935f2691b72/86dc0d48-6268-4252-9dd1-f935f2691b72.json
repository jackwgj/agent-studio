rFields":{"inputs":[{"sourceType":"ref","description":"用户输入","id":"topic","type":"string","required":false}],"outputs":[{"sourceType":"null","description":"该节点原始输出","id":"title","type":"string","required":false},{"sourceType":"null","description":"该节点原始输出","id":"content","type":"string","required":true}]},"deployMode":"workflow","systemFields":{"inputs":[],"outputs":[]},"enableHistory":false,"templateContent":[{"content":"你是课件/教案写作大师。请根据用户提供的主题“{{topic}}”，用JSON格式输出标题{title}和内容大纲{content}。\n内容大纲{content}的内容需要以markdown结构输出，例如：\n====示例开始====\n{\n  \"content\": \n    \"## 开场<br>- 引入主题：简述农业在国家发展中的重要地位，引出中国传统文化与农业的紧密联系。<br>- 介绍重要性和必要性：强调理解中国传统文化对农业意义的紧迫性和现实需求。<br>## 一、中国传统文化中的农业思想<br>- 儒家的农业观：阐述儒家思想中对农业的重视及相关理念。<br>- 道家的自然观与农业：分析道家自然观念对农业生产方式的影响。<br>- 法家的农业政策主张：探讨法家在农业管理方面的思想。<br> ## 二、传统节日与农业<br>- 春节与农业的关系：说明春节的习俗如何反映农业生产的节奏。<br>- 中秋等节日与农业的关联：分析中秋等传统节日中蕴含的农业元素。## 三、传统技艺与农业<br>- 传统手工艺对农业工具的贡献：介绍传统手工艺制作的农业工具及其特点。<br>- 传统建筑技艺与农业生产环境：讲解传统建筑技艺如何为农业创造适宜的生产环境。## 四、传统哲学对农业可持续发展的启示<br>- 天人合一理念与农业生态平衡：阐述天人合一思想对维持农业生态平衡的指导意义。<br>- 中庸之道与农业适度发展：分析中庸之道在农业发展中的适度原则。## 五、传统文学艺术中的农业<br>- 古代诗词中的农业描写：举例说明古代诗词如何展现农业生产场景和农民生活。<br>- 传统绘画中的农业题材：分析传统绘画中农业题材所传达的情感和价值观。## 六、传统农业文化的现代价值<br>- 对现代农业理念的影响：探讨传统农业文化对现代生态农业理念的启示。<br>- 传统农业文化在乡村振兴中的作用：阐述传统农业文化在乡村振兴战略中的积极意义。## 七、传承与发展<br>- 如何传承传统农业文化：提出传承传统农业文化的方法和途径。<br>- 创新发展传统农业文化：讨论如何在现代社会创新发展传统农业文化。## 结束语<br>- 重要性的再次强调：总结中国传统文化对农业的重要意义。<br>- 鼓励传承与创新：激励人们积极传承和创新传统农业文化。\"\n  ],\n  \"title\": \"中国传统文化对于农业的意义\"\n}\n====示例结束====\n\n## 限制\n1. 大纲的正文需要包含中文序列号，如“一、”“二、”“三、”等\n","role":"user"}],"responseFormat":{"jsonInstruction":"","type":"json"},"model":{"modelName":"free-deepseek-v3","extension":{"deploymentId":"free-deepseek-v3"},"hyperParameters":{"top_p":0.5,"temperature":0.5},"modelType":"LLM"}},"inputs":{"userFields":{"topic":"${node_start.systemFields.query}"}},"name":"生成大纲","id":"node_llm","type":"jiuwen.LLMComponent"},{"outputs":{"userFields":{"raw_output":""}},"configs":{"userFields":{"inputs":[{"sourceType":"ref","description":"","id":"title","type":"string","required":false},{"sourceType":"ref","description":"","id":"input","type":"string","required":true}],"outputs":[{"sourceType":"input","description":"模型原始输出","id":"raw_output","type":"string","required":false}]},"deployMode":"workflow","systemFields":{"inputs":[],"outputs":[]},"enableHistory":false,"templateContent":[{"content":"你是教案、课件写作专家教师，你精通语文和历史科目。请根据用户提供的主题、大纲、参考资料信息、参考图，完成这一部分的详细写作，并用markdown的格式输出。\n主题：{{title}}\n大纲：{{input}}\n\n\n===输出案例参考===\n# 段落标题\n## 小标题1\n正文1\n## 小标题2\n正文2\n\n\n\n## 讨论与反馈\n1. 思考题1：...<br>\n2. 思考题2：...<br>\n3. 思考题3：...<br>\n===输出案例结束===\n\n## 限制\n1. 不要输出其他无关内容。\n","role":"user"}],"responseFormat":{"type":"text"},"model":{"modelName":"free-deepseek-v3","extension":{"deploymentId":"free-deepseek-v3"},"hyperParameters":{"top_p":0.5,"temperature":0.5},"modelType":"LLM"}},"inputs":{"userFields":{"input":"${node_llm.userFields.content}","title":"${node_llm.userFields.title}"}},"name":"生成文章","id":"node_1742781254553","type":"jiuwen.LLMComponent"},{"outputs":{"userFields":{},"responseContent":""},"configs":{"responseMode":"directResponse","userFields":{"inputs":[{"sourceType":"ref","description":"最终输出","id":"result","type":"string","required":false}],"outputs":[]},"responseTemplate":"{{result}}","systemFields":{"inputs":[],"outputs":[]},"isStreamOut":true},"inputs":{"userFields":{"result":"${node_1742781254553.userFields.raw_output}"}},"name":"结束","id":"node_end","type":"jiuwen.end"}],"metadata":{"visibility":"global","publishedAt":1757993365983,"userId":"660f2322011748ceaefc45d122111ef2","projectId":"d71609fe080248dcbe275bca76b681b3","domainId":"294b3cc185bd4cca9d69095690159432","workspaceId":"2a9fcbed03d04437b47acd2dba98d8e7","updatedAt":1758013674245,"status":"published"},"schemaVersion":"0.6.0","description":"当用户想要生成课件/教案时，调用此工作流","workflowName":"write_gen","workflowVersion":"0.6.0","workflowId":"86dc0d48-6268-4252-9dd1-f935f2691b72","connections":[{"source":{"componentId":"node_start","parallelBranchId":"bxizbfadtfoostnj"},"targ