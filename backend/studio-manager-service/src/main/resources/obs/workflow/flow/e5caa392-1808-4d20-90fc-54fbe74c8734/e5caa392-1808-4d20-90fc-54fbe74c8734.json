己对历史的深刻理解，而不仅仅是简单的描述。\n多角度思考：如果题目允许，可以从不同的角度进行分析，如政治、经济、文化、社会等多方面，展现出对历史事件全面的理解。\n平衡与客观：在分析历史事件时，要保持客观、公正，避免单方面或片面的解释。如果有争议性的问题，可以提到不同的历史观点，但要注意说明自己的立场并给出理由。\n\n## 题目：{{question}}\n## 用户回答：{{user_answer}}\n\n## 输出示例\n📖 题目：....\n📖 回答：....\n🌟 分数：n/10\n✍️ 原因：\n1. \n2. \n3. \n4. \n5. ","temperature":0.5,"model":{"model_name":"DeepSeek-V3","model_type":"LLM","model_deployment_id":"free-deepseek-v3"},"system_prompt":"","enable_history":false},"id":"node_1742550941922","inputs":[{"cn_name":null,"description":"","field_type":null,"memory":null,"name":"question","reflection":false,"required":false,"schema":null,"source":"user","type":"string","validator":null,"value":{"content":{"ref_node_id":"node_llm","ref_var_name":"question","source":"user"},"default":null,"display":null,"hint":"","type":"ref"}},{"cn_name":null,"description":"","field_type":null,"memory":null,"name":"user_answer","reflection":false,"required":true,"schema":null,"source":"user","type":"string","validator":null,"value":{"content":{"ref_node_id":"node_llm","ref_var_name":"user_anwser","source":"user"},"default":null,"display":null,"hint":"","type":"ref"}}],"name":"内容批改","outputs":[{"cn_name":null,"description":"模型原始输出","field_type":null,"memory":null,"name":"review","reflection":false,"required":false,"schema":null,"source":"user","type":"string","validator":null,"value":{"content":"","default":null,"display":null,"hint":"","type":"literal"}}],"type":"LLM"}]}