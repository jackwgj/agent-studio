              "operator": "and"
            }
          },
          {
            "id": "node_1724463906979-elseIf-1",
            "boolExpression": {
              "expressions": [
                "${node_start.query} equal 米饭",
                "${node_default_llm_chain.raw_output} equal 食物"
              ],
              "operator": "or"
