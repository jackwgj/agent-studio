<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <contextName>agent-builder-agent-runtime</contextName>

    <Properties>
        <Property name="LOG_PATH">/opt/cloud/logs/agent-builder-agent-runtime</Property>
        <Property name="TRACE_LOG_PATH">/opt/cloud/logs/agent-builder-agent-runtime/audit</Property>
        <Property name="ALARM_LOG_PATH">/opt/cloud/logs/agent-builder-agent-runtime/alarm</Property>
        <Property name="FILE_NAME" value="agent-builder-agent-runtime" />
        <Property name="PERFORM_FILE" value="perform" />
        <Property name="TRACE_FILE" value="trace" />

        <!-- 主日志配置 -->
        <Property name="LOG_FILE_ROLLING_SIZE" value="${env:LOG_FILE_ROLLING_SIZE:-100MB}" />
        <Property name="LOG_FILE_MAX_COUNT" value="${env:LOG_FILE_MAX_COUNT:-100}" />
        <Property name="LOG_FILE_MAX_AGE" value="${env:LOG_FILE_MAX_AGE:-7d}" />
        <Property name="LOG_FILE_MAX_TOTAL_SIZE" value="${env:LOG_FILE_MAX_TOTAL_SIZE:-1GB}" />
        <Property name="LOG_FILE_MAX_TOTAL_COUNT" value="${env:LOG_FILE_MAX_TOTAL_COUNT:-100}" />

        <!-- 性能日志配置 -->
        <Property name="PERFORM_FILE_ROLLING_SIZE" value="${env:PERFORM_FILE_ROLLING_SIZE:-100MB}" />
        <Property name="PERFORM_FILE_MAX_COUNT" value="${env:PERFORM_FILE_MAX_COUNT:-100}" />
        <Property name="PERFORM_FILE_MAX_AGE" value="${env:PERFORM_FILE_MAX_AGE:-30d}" />
        <Property name="PERFORM_FILE_MAX_TOTAL_SIZE" value="${env:PERFORM_FILE_MAX_TOTAL_SIZE:-500MB}" />
        <Property name="PERFORM_FILE_MAX_TOTAL_COUNT" value="${env:PERFORM_FILE_MAX_TOTAL_COUNT:-100}" />

        <!-- 接口日志配置 -->
        <Property name="INF_FILE_ROLLING_SIZE" value="${env:INF_FILE_ROLLING_SIZE:-100MB}" />
        <Property name="INF_FILE_MAX_COUNT" value="${env:INF_FILE_MAX_COUNT:-100}" />
        <Property name="INF_FILE_MAX_AGE" value="${env:INF_FILE_MAX_AGE:-30d}" />
        <Property name="INF_FILE_MAX_TOTAL_SIZE" value="${env:INF_FILE_MAX_TOTAL_SIZE:-1GB}" />
        <Property name="INF_FILE_MAX_TOTAL_COUNT" value="${env:INF_FILE_MAX_TOTAL_COUNT:-100}" />

        <!-- 审计日志配置 -->
        <Property name="TRACE_FILE_ROLLING_SIZE" value="${env:TRACE_FILE_ROLLING_SIZE:-50MB}" />
        <Property name="TRACE_FILE_MAX_COUNT" value="${env:TRACE_FILE_MAX_COUNT:-200}" />
        <Property name="TRACE_FILE_MAX_AGE" value="${env:TRACE_FILE_MAX_AGE:-180d}" />

        <Property name="LOG_PATTERN"
                  value="[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%-5level] [%X{request-id}] [%X{task-id}] [%thread] [%logger{15}:%L] - [%msg]%n" />
        <Property name="INF_LOG_PATTERN" value="[%X{request-id}] [%X{task-id}] [%thread] - [%msg]%n" />
        <Property name="PERF_LOG_PATTERN" value="[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%X{request-id}] [%X{task-id}] - %msg%n" />
        <Property name="TRACE_LOG_PATTERN" value="%msg%n" />

        <!-- 告警日志配置 -->
        <Property name="ALARM_FILE" value="alarm" />
        <Property name="ALARM_LOG_PATTERN" value="%msg%n"/>
        <Property name="ALARM_FILE_ROLLING_SIZE" value="${env:ALARM_FILE_ROLLING_SIZE:-100MB}" />
        <Property name="ALARM_FILE_MAX_COUNT" value="${env:ALARM_FILE_MAX_COUNT:-100}" />
        <Property name="ALARM_FILE_MAX_AGE" value="${env:ALARM_FILE_MAX_AGE:-30d}" />


    </Properties>

    <Appenders>
        <!-- Console output -->
        <Console  name="STDOUT"  target="SYSTEM_OUT">
            <!--            <PatternLayout  pattern="${LOG_PATTERN}"/>-->
            <UsPatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- Specify the name of the log file -->
        <RollingFile name="ROLLING_FILE">
            <FileName>${LOG_PATH}/${FILE_NAME}.log</FileName>
            <FilePattern>${LOG_PATH}/${FILE_NAME}-%d{yyyy-MM-dd}.%i.zip</FilePattern>
            <UsPatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="${LOG_FILE_ROLLING_SIZE}" />
            </Policies>
            <!--每个日期格式下保留的最大文件数-->
            <DefaultRolloverStrategy max="${LOG_FILE_MAX_COUNT}">
                <Delete basePath="${LOG_PATH}" maxDepth="2">
                    <IfFileName glob="*${FILE_NAME}-20*.zip" />
                    <IfAny>
                        <IfLastModified age="${LOG_FILE_MAX_AGE}" />
                        <IfAccumulatedFileSize exceeds="${LOG_FILE_MAX_TOTAL_SIZE}" />
                        <IfAccumulatedFileCount exceeds="${LOG_FILE_MAX_TOTAL_COUNT}" />
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>

        </RollingFile>

        <RollingFile name="ROLLING_FILE_PERFORM">
            <FileName>${LOG_PATH}/${PERFORM_FILE}.log</FileName>
            <FilePattern>${LOG_PATH}/${PERFORM_FILE}-%d{yyyy-MM-dd}.%i.zip</FilePattern>
            <UsPatternLayout pattern="${PERF_LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="${PERFORM_FILE_ROLLING_SIZE}" />
            </Policies>
            <DefaultRolloverStrategy max="${PERFORM_FILE_MAX_COUNT}">
                <Delete basePath="${LOG_PATH}" maxDepth="2">
                    <IfFileName glob="*${PERFORM_FILE}-*.zip" />
                    <IfAny>
                        <IfLastModified age="${PERFORM_FILE_MAX_AGE}" />
                        <IfAccumulatedFileSize exceeds="${PERFORM_FILE_MAX_TOTAL_SIZE}" />
                        <IfAccumulatedFileCount exceeds="${PERFORM_FILE_MAX_TOTAL_COUNT}" />
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- 接口日志的appender -->
        <RollingFile name="ROLLING_FILE_INF">
            <FileName>${LOG_PATH}/${FILE_NAME}-interface.log</FileName>
            <FilePattern>${LOG_PATH}/${FILE_NAME}-interface-%d{yyyy-MM-dd}.%i.zip</FilePattern>
            <UsPatternLayout pattern="${INF_LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="${INF_FILE_ROLLING_SIZE}" />
            </Policies>
            <DefaultRolloverStrategy max="${INF_FILE_MAX_COUNT}">
                <Delete basePath="${LOG_PATH}" maxDepth="2">
                    <IfFileName glob="*${FILE_NAME}-interface-*.zip" />
                    <IfAny>
                        <IfLastModified age="${INF_FILE_MAX_AGE}" />
                        <IfAccumulatedFileSize exceeds="${INF_FILE_MAX_TOTAL_SIZE}" />
                        <IfAccumulatedFileCount exceeds="${INF_FILE_MAX_TOTAL_COUNT}" />
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- 审计日志配置规则 -->
        <RollingFile name="ROLLING_FILE_TRACE">
            <FileName>${TRACE_LOG_PATH}/${TRACE_FILE}.log</FileName>
            <FilePattern>${TRACE_LOG_PATH}/${TRACE_FILE}-%d{yyyy-MM-dd}.%i.zip</FilePattern>
            <UsPatternLayout pattern="${TRACE_LOG_PATTERN}"/>
            <ImmediateFlush>true</ImmediateFlush>
            <Policies>
                <SizeBasedTriggeringPolicy size="${TRACE_FILE_ROLLING_SIZE}"/>
                <TimeBasedTriggeringPolicy interval="1" />
            </Policies>
            <DefaultRolloverStrategy max="${TRACE_FILE_MAX_COUNT}">
                <Delete basePath="${TRACE_LOG_PATH}" maxDepth="2">
                    <IfFileName glob="*${TRACE_FILE}-*.zip" />
                    <IfLastModified age="${TRACE_FILE_MAX_AGE}" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="ROLLING_FILE_ALARM">
            <FileName>${ALARM_LOG_PATH}/${ALARM_FILE}.log</FileName>
            <FilePattern>${ALARM_LOG_PATH}/${ALARM_FILE}-%d{yyyy-MM-dd}.%i.zip</FilePattern>
            <UsPatternLayout pattern="${ALARM_LOG_PATTERN}"/>
            <ImmediateFlush>true</ImmediateFlush>
            <Policies>
                <SizeBasedTriggeringPolicy size="${ALARM_FILE_ROLLING_SIZE}"/>
                <TimeBasedTriggeringPolicy interval="1" />
            </Policies>
            <DefaultRolloverStrategy max="${ALARM_FILE_MAX_COUNT}">
                <Delete basePath="${ALARM_LOG_PATH}" maxDepth="3">
                <IfFileName glob="*${ALARM_FILE}-*.zip" />
                    <IfLastModified age="${ALARM_FILE_MAX_AGE}" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="STDOUT" />
            <AppenderRef ref="ROLLING_FILE" />
        </Root>
        <Logger name="com.openjiuwen.studio.agent.runtime.utils.PerformLogger" level="info"
                additivity="true">
            <AppenderRef ref="ROLLING_FILE_PERFORM" />
        </Logger>
        
        <!-- 告警日志 logger 配置 -->
        <Logger name="ALARM_LOGGER" level="info" additivity="true">
            <AppenderRef ref="ROLLING_FILE_ALARM" />
        </Logger>
        
    </Loggers>
</Configuration>
