# studio-runtime 本地开发配置

# ============ Redis配置（必填） ============
# 本地开发仅提供单机模式配置，集群/哨兵模式请参考 docker/compose/.env.example
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis数据库编号，默认0
REDIS_DATABASE=0
# Redis模式：single/cluster/sentinel，默认single
REDIS_MODE=single

# ============ 对象存储配置（必填） ============
# OBS_URL格式：
# MinIO：https://<MINIO_IP>:9000
# 公有云OBS：https://<OBS_ENDPOINT>:443
DATASOURCE_OBS_SERVER=
DATASOURCE_OBS_BUCKET=
DATASOURCE_OBS_AK=
DATASOURCE_OBS_SK=
# 对象存储SSL验证，默认false
DATASOURCE_OBS_ENABLE_SSL=false

# ============ 服务间调用地址（默认无需修改） ============
# studio-service调用地址，HTTPS启动需要改成https
MODEL_ROUTER_API=http://127.0.0.1:31113/v1/agent-builder

# ============ HTTPS配置（选填） ============
# 启用HTTPS时设HTTPS=true，并配置证书路径
HTTPS=false
TLS_CERT_PATH=
TLS_CERT_KEY_PATH=
TLS_CERT_KEY_PASSWD=

# ============ 沙箱配置（选填） ============
# 远程沙箱地址（配置后启用沙箱模式，为空则沙箱不可用自动走 local）
SECURITY_SANDBOX_SERVER=
# SSL 验证
SECURITY_SANDBOX_SSL_VERIFY=false
# 沙箱空闲超时（秒）
SECURITY_SANDBOX_IDLE_TTL=600
# 执行超时（秒）
SECURITY_SANDBOX_TIMEOUT=300
# 隔离级别：system / session
SECURITY_SANDBOX_SCOPE=system

# ============ OpenSearch配置（选填，启用记忆库时必填） ============
# 格式: host:port，多节点用逗号分隔，如 host1:9200,host2:9200
OPENSEARCH_HOSTS=
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_SSL_VERIFY=false

# ============ 记忆库配置（选填，默认关闭） ============
# 总开关，设为true启用记忆库功能
MEMORY_ENABLED=false
LONG_TERM_MEMORY_ENABLE=false
MEMORY_USER_PROFILE_ENABLE=false
# 记忆库抽取用的Embedding模型配置（启用记忆库时必填）
MEMORY_EMBEDDING_MODEL=bge-m3
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
# 记忆库抽取用的LLM模型配置（启用记忆库时必填）
MEMORY_LLM_MODEL=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=

# ============ 记忆库MySQL存储配置（选填，启用记忆库时必填） ============
# 记忆库文本数据存储，可与主库共用同一MySQL实例，使用独立数据库
MEMORY_DB_HOST=
MEMORY_DB_PORT=3306
MEMORY_DB_USER=
MEMORY_DB_PASSWORD=
MEMORY_DB_NAME=agent-memory

# ============ 其他配置（选填） ============
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 工作流日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
# WORKFLOW_LOG_LEVEL=INFO
# LLM API Key占位符（任意非空字符串即可）
IR_LLM_API_KEY=sk-placeholder
# 插件节点是否启用SSL验证
PLUGIN_SSL_API_CERT=false
# 工作流执行超时时间（秒）
WORKFLOW_EXECUTE_TIMEOUT=900


# ============ OpenTelemetry 配置（选填，默认关闭） ============
# 总开关，设为true启用OTel trace上报
OTEL_ENABLED=false
# Exporter类型：console（输出到控制台）/ otlp（上报到远端Collector）
OTEL_EXPORTER_TYPE=console
# OTLP Collector地址（OTEL_EXPORTER_TYPE=otlp时必填），如 http://localhost:4317
OTEL_EXPORTER_ENDPOINT=
# 传输协议：grpc / http，默认grpc
OTEL_PROTOCOL=grpc
# OTLP请求头（JSON格式），如 {"Authorization":"Bearer xxx"}
OTEL_HEADERS={}
# 服务名标识，默认agent-runtime
OTEL_SERVICE_NAME=agent-runtime
# 服务版本号
OTEL_SERVICE_VERSION=
# 采样率（0.0-1.0），1.0为全量采样
OTEL_SAMPLE_RATE=1.0
# 批量导出间隔（毫秒）
OTEL_SCHEDULE_DELAY_MILLIS=5000
# 导出超时（毫秒）
OTEL_EXPORT_TIMEOUT_MS=30000
# 每批最大span数
OTEL_MAX_EXPORT_BATCH_SIZE=512
# 数据脱敏开关，设为true
OTEL_REDACTION_ENABLED=true
# 脱敏LLM输入（prompt），设为true则遮盖prompt内容
OTEL_REDACT_PROMPTS=
# 脱敏LLM输出（completion），设为true则遮盖completion内容
OTEL_REDACT_COMPLETIONS=
# Span属性值最大长度，超长截断
OTEL_MAX_ATTR_LENGTH=4096