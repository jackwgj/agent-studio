    {
      "id": "CONTINUE_BRANCH",
      "type": "jiuwen.switchCase",
      "branches": [
        {
          "branchId": "continue",
          "boolExpression": "${SHOULD_CONTINUE.judge_res} == 1"
        },
        {
          "branchId": "not_continue",
          "boolExpression": "${SHOULD_CONTINUE.judge_res} == 0"
        }
      ],
      "configs": {
        "debugType": {
          "debugTree": false
        }
      }
    },
    {
      "id": "SKILL_TYPE_BRANCH",
      "type": "jiuwen.switchCase",
      "branches": [
        {
          "branchId": "plugin_execute",
          "boolExpression": "${SKILL_INPUT_PARSER.skillType} == 'Plugin'"
        },
        {
          "branchId": "workflow_execute",
          "boolExpression": "${SKILL_INPUT_PARSER.skillType} == 'Workflow'"
        }
      ],
      "configs": {
        "debugType": {
          "debugTree": false
        }
      }
    },
    {
      "id": "SKILL_OUTPUT_TYPE_BRANCH",
      "type": "jiuwen.switchCase",
      "branches": [
        {
          "branchId": "next_iteration",
          "boolExpression": "${SKILL_OUTPUT_PARSER.outputType} == 'LLMResponse'"
        },
        {
          "branchId": "end",
          "boolExpression": "${SKILL_OUTPUT_PARSER.outputType} == 'directResponse'"
        }
      ],
      "configs": {
        "debugType": {
          "debugTree": false
        }
      }
    },
    {
      "id": "SKILL_OUTPUT_TRUE_BRANCH",
      "type": "jiuwen.switchCase",
      "branches": [
        {
          "branchId": "skill_output_true",
          "boolExpression": "'continue' == 'continue'"
        }
      ],
      "configs": {
        "debugType": {
          "debugTree": false
        }
      }
    },
    {
      "id": "CONTINUE_TRUE_BRANCH",
      "type": "jiuwen.switchCase",
      "branches": [
        {
          "branchId": "continue_true",
          "boolExpression": "'continue' == 'continue'"
        }
      ],
      "configs": {
        "debugType": {
          "debugTree": false
        }
      }
    },
    {
      "id": "PLUGIN_TRUE_BRANCH",
      "type": "jiuwen.switchCase",
      "branches": [
        {
          "branchId": "plugin_true",
          "boolExpression": "'continue' == 'continue'"
        }
      ],
      "configs": {
        "debugType": {
          "debugTree": false
        }
      }
    },
    {
      "id": "WORKFLOW_TRUE_BRANCH",
      "type": "jiuwen.switchCase",
      "branches": [
        {
          "branchId": "workflow_true",
          "boolExpression": "'continue' == 'continue'"
        }
      ],
      "configs": {
        "debugType": {
          "debugTree": false
        }
      }
    },
    {
      "id": "END_TRUE_BRANCH",
      "type": "jiuwen.switchCase",
      "branches": [
        {
          "branchId": "workflow_true",
          "boolExpression": "'continue' == 'continue'"
        }
      ],
      "configs": {
        "debugType": {
          "debugTree": false
        }
      }
    },
    {
      "id": "END_PLANNING",
