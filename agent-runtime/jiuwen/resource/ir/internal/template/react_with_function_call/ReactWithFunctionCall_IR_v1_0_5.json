        "mockResults": "${configs.mockResults}",
        "model": "${configs.model}",
        "templateContent": "${configs.promptTemplateContent}",
        "refinerConfig": "${configs.promptRefinerConfig}",
        "toolCallFormat": "${configs.promptToolCallFormat}",
        "preDefinedFields": {
          "inputs": [
            {
              "id": "variables",
              "type": "Map<String, T>",
              "description": "需要向Prompt模板占位符中填充的变量，以字典的形式传入，键名为占位符变量名称，值为占位符变量的值",
              "sourceType": "ref"
            },
            {
              "id": "history",
              "type": "List<Map<String, T>>",
              "description": "包含历史对话的消息列表",
              "sourceType": "ref"
            },
            {
              "id": "query",
              "type": "String",
              "description": "用户的当前query，用于作为对话历史和插件列表优选的key",
              "sourceType": "ref"
            },
            {
              "id": "templateContent",
              "type": "List<Map<String, T>>",
              "description": "用户定义的prompt模板，可以包含${}形式的占位符，如果传入，会覆盖configs中的模板",
              "sourceType": "ref"
            },
            {
              "id": "variableFormatSchema",
              "type": "Map<String, T>",
              "description": "用于配置模板内占位符填充内容及其格式化方式",
              "sourceType": "ref"
            },
            {
              "id": "tools",
              "type": "List<Map<String, T>>",
              "description": "用户自定义的工具",
              "sourceType": "ref"
            }
          ],
          "outputs": [
            {
              "id": "message",
              "type": "Map<String, T>",
              "description": "返回的助手message"
            },
            {
              "id": "metadata",
              "type": "Map<String, T>",
              "description": "访问大模型相关的信息，如时延，消耗token数量等"
            }
          ]
        },
        "debugType": {
          "debugPreview": true
        }
      },
      "inputs": {
        "variables": "${CONSTRUCT_PROMPT.variables}",
        "query": "${CONSTRUCT_PROMPT.query}",
        "history": "${CONSTRUCT_PROMPT.history}",
        "tools": "${CONSTRUCT_PROMPT.tools}"
