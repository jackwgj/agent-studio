{
  "type": "jiuwen.planner.components.planner_component:PlannerComponent",
  "version": "1.0.5",
  "componentCatalog": "compositeComponent",
  "description": "对用户任务/问题进行规划，生成完成任务的计划，并根据计划借助一个或多个工具（包括插件、工作流等），完成用户指定任务或回答用户问题",
  "schemaVersion": "0.6",
  "classInfo": {
    "modulePath": "jiuwen.planner.components.planner_component",
    "className": "PlannerComponent",
    "programLanguage": "python",
    "filePath": "jiuwen/planner/components/planner_component.pyc"
  },
  "inputs": [
    {
      "id": "query",
      "description": "用户输入",
      "type": "String"
    }
  ],
  "outputs": [
    {
      "id": "output",
      "description": "规划输出，包含对用户任务规划的最终结果;",
      "type": "String"
    }
  ],
  "configs": [
    {
      "id": "model",
      "description": "规划过程中使用的大模型的名称",
      "type": "Map<String, T>"
    },
    {
      "id": "promptRefinerConfig",
      "description": "规划过程中透传给prompt组件的优选配置",
      "type": "Map<String, T>"
    },
    {
      "id": "promptToolCallFormat",
      "description": "规划过程中透传给prompt组件的优选配置",
      "type": "Map<String, T>"
    },
    {
      "id": "promptTemplateContent",
      "type": "List<Map<String, T>>",
      "description": "用户定义的prompt模板，可以包含${}形式的占位符"
    },
    {
      "id": "plugins",
      "type": "List<Map<String, T>>",
      "description": "供大模型调用的插件列表"
    },
    {
      "id": "workflows",
      "type": "List<Map<String, T>>",
      "description": "供大模型调用的workflow列表"
    },
    {
      "id": "streamOutput",
      "description": "流式蹦字开关",
      "type": "Boolean"
    },
    {
      "id": "mockResults",
      "description": "mock结果",
      "type": "List<Map<String, T>>"
    },
    {
      "id": "parseMethod",
      "description": "LLM解析方式",
      "type": "String"
    },
    {
      "id": "customComponents",
      "type": "Map<String, componentRef>",
      "description": "开发者自定义的组件列表，用于自动替换默认同名组件，当前支持替换的组件有 selectorComponent、pluginComponent和uiComponent"
    },
    {
      "id": "queryTemplateContent",
      "type": "List<Map<String, T>>",
      "description": "query改写的模版列表，如知识库检索片段需要改写"
    },
    {
      "id": "needLLMSummary",
      "description": "控制规划流程中是否调用大模型总结的全局开关",
      "type": "Boolean"
    },
    {
      "id": "userFields",
      "type": "Map<String, T>",
      "description": "用户参数信息配置"
    },
    {
      "id": "preDefinedFields",
      "type": "Map<String, T>",
      "description": "预定义参数信息配置"
    },
    {
      "id": "customWorkflows",
      "type": "Map<String, T>",
      "description": "开发者自定义的workflow，在特定场景触发"
    }
  ]
}
