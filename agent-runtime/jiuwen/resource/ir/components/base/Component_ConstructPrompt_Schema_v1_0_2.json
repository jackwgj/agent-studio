  },
  "description": "构建Prompt输入",
  "inputs": [
    {
      "id": "postPluginList",
      "description": "选择的id列表",
      "type": "List[Map<String, T>]"
    },
    {
      "id": "postWorkflowList",
      "description": "选择的id列表",
      "type": "List[Map<String, T>]"
    },
    {
      "id": "knowledgeSegments",
      "description": "知识库返回的检索片段",
      "type": "List[String]"
    }
  ],
  "outputs": [
    {
      "id": "variables",
      "type": "Map<String, T>",
      "description": "需要向Prompt模板占位符中填充的变量，以字典的形式传入，键名为占位符变量名称，值为占位符变量的值"
    },
    {
      "id": "history",
      "type": "List<Map<String, T>>",
